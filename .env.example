# LLM Configuration (Gemini recommandé, ou OpenAI / Ollama)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# Automation Settings
HEADLESS_BROWSER=false
HUMAN_IN_THE_LOOP=true

# Email Verification (IMAP) — auto-validation des codes de vérification
# envoyés par les ATS externes lors de la création de compte.
# Utilisez un mot de passe d'application (Gmail/Outlook), jamais votre mdp principal.
# EMAIL_VERIFICATION_ENABLED=true
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_USERNAME=eliot.hantute@gmail.com
# EMAIL_IMAP_PASSWORD=your_app_password_here
# EMAIL_VERIFICATION_POLICY=skip   # "auto" ou "skip"
